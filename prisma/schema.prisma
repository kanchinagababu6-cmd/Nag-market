model Product {
  id          String   @id @default(uuid())
  barcode     String   @unique
  name        String
  price       Float
  stock       Int      @default(0)
  category    String   @default("Staples & Grains")
  subCategory String   @default("Atta, Flours & Sooji")
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
